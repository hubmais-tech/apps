NODE_ENV=development
PORT=3340
DATABASE_URL=postgresql://docker:docker@localhost:5959/hubmais
FRONTEND_URL=http://localhost:5173
JWT_SECRET=troque-por-um-segredo-longo-com-32-caracteres-ou-mais

# Cloudflare R2 (S3 compatível)
CLOUDFLARE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=hubmais-media
# URL pública do bucket para capas (vídeos usam URL assinada)
CLOUDFLARE_PUBLIC_URL=https://media.exemplo.com

# Pagamentos: "stripe" ou "fake" (somente desenvolvimento)
PAYMENT_GATEWAY=fake
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Regras financeiras
PLATFORM_FEE_PERCENT=20
WALLET_HOLD_DAYS=7
MIN_WITHDRAWAL_IN_CENTS=5000

# Usuário admin criado pelo seed
SEED_ADMIN_EMAIL=admin@hubmais.local
SEED_ADMIN_PASSWORD=trocar-esta-senha
