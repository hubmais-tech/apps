# Variáveis do deploy com Docker Compose (docker-compose.yml na raiz). Copie para .env e preencha.
# O .env NUNCA vai para o git. Em plataformas (Render, Railway, Fly, Coolify...), cadastre as mesmas
# variáveis no painel, em cada serviço. Detalhes e lista completa: docs/DEPLOY.md.

# ---------- Endereços públicos ----------
# Como o navegador acessa o site e a API (com https em produção). FRONTEND_URL aceita vários, separados por vírgula.
FRONTEND_URL=https://hubmais.exemplo.com
API_PUBLIC_URL=https://api.hubmais.exemplo.com
# Portas publicadas no servidor (atrás de um proxy com HTTPS, como Caddy, Traefik ou o da plataforma).
WEB_PORT=8080
API_PORT=3333

# ---------- Banco ----------
# Evite caracteres especiais (@ : / ?) na senha, porque ela entra na URL de conexão.
POSTGRES_PASSWORD=troque-por-uma-senha-forte

# ---------- API ----------
# Mínimo de 32 caracteres. Gere com: openssl rand -base64 48
JWT_SECRET=
# production (padrão) exige PAYMENT_GATEWAY=stripe. Só use development + fake para testar a stack localmente.
NODE_ENV=production
TRUST_PROXY=true

# Cloudflare R2 (capas e vídeos). O bucket precisa de CORS liberando PUT e GET para o FRONTEND_URL.
CLOUDFLARE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
CLOUDFLARE_ACCESS_KEY_ID=
CLOUDFLARE_SECRET_ACCESS_KEY=
CLOUDFLARE_BUCKET_NAME=hubmais-media
CLOUDFLARE_PUBLIC_URL=https://media.hubmais.exemplo.com

# Stripe. O webhook aponta para ${API_PUBLIC_URL}/webhooks/stripe
PAYMENT_GATEWAY=stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Regras financeiras (valores padrão; PLATFORM_FEE_PERCENT ainda é suposição, ver A14)
PLATFORM_FEE_PERCENT=20
GATEWAY_FEE_PERCENT=3.99
GATEWAY_FEE_FIXED_IN_CENTS=39
WALLET_HOLD_DAYS=7
MIN_WITHDRAWAL_IN_CENTS=5000

# Primeiro admin, criado uma vez com: docker compose exec api node dist/seed.js (ou RUN_SEED=true na primeira partida)
RUN_SEED=false
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
